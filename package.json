{
  "name": "shiyan",
  "private": true,
  "version": "1.0.0",
  "description": "拾焰 · 本地优先的念头、目标与火种手记",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "build:single": "tsc --noEmit && vite build --config vite.single.config.ts && node scripts/package-single.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit --pretty false"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.1",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.8",
    "vite-plugin-pwa": "^2.0.0"
  }
}
